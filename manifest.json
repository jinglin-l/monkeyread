{
  "manifest_version": 3,
  "name": "monkeyread",
  "version": "0.1.1",
  "description": "press m on any page to type over its main text, monkeytype style, with live wpm and accuracy.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "monkeyread@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
